# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=securepassword
DB_NAME=appdb
DATABASE_URL=postgresql://postgres:securepassword@db:5432/appdb

# ---------------------------------------------------------------------------
# JWT auth
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Google OAuth - used for "Sign in with Google". If left blank, Google OAuth
# login is disabled and the backend logs a warning instead of failing.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Google Forms/Sheets sync - service account credentials (JSON) used by the
# APScheduler job that pulls assignment submissions from a Google Sheet. If
# left blank, the sync job no-ops and logs a warning each run.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_FORMS_SHEET_ID=
GOOGLE_FORMS_SYNC_INTERVAL_MINUTES=5

# ---------------------------------------------------------------------------
# GitHub API - personal access token used to fetch submitted repo contents
# for evaluation. If left blank, GitHub fetching is skipped with a warning.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_MAX_FILES=200
GITHUB_MAX_TOTAL_BYTES=2000000
GITHUB_FETCH_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Anthropic API - powers the AI "roast"/evaluation of submissions. If left
# blank, AI evaluation is skipped (static evaluation only) and a warning is
# logged.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# SendGrid - sends result/notification emails to students. If left blank,
# email sending no-ops and logs a warning instead of failing.
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com

# ---------------------------------------------------------------------------
# Evaluation score weighting (AI score weight + static score weight must
# sum to 1.0)
# ---------------------------------------------------------------------------
EVALUATION_AI_WEIGHT=0.6
EVALUATION_STATIC_WEIGHT=0.4

# ---------------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
VITE_API_URL=http://localhost:8000
